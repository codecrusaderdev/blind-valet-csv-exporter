{
  "manifest_version": 3,
  "name": "Blind Valet CSV Exporter",
  "description": "Exports visible Blind Valet tournament data to CSV.",
  "version": "0.1.1",
  "action": {
    "default_title": "Export Blind Valet tournaments",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://blindvalet.com/*", "https://*.blindvalet.com/*"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://blindvalet.com/*", "https://*.blindvalet.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
